{
  "name": "vue-instantsearch",
  "author": {
    "name": "Algolia, Inc.",
    "url": "https://www.algolia.com"
  },
  "description": "👀 Lightning-fast Algolia search for Vue apps",
  "keywords": [
    "vue",
    "algolia",
    "search",
    "instantsearch",
    "components",
    "ui",
    "facet",
    "autocomplete"
  ],
  "license": "MIT",
  "version": "4.24.4",
  "files": [
    "dist",
    "src"
  ],
  "module": "dist/es",
  "types": "dist/es/src/instantsearch.d.ts",
  "sideEffects": false,
  "repository": "https://github.com/algolia/instantsearch",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup -c rollup.config.mjs",
    "build:types": "vue-tsc -p tsconfig.declaration.json --outDir ./dist/es",
    "type-check": "vue-tsc --noEmit",
    "storybook": "NODE_OPTIONS=--openssl-legacy-provider start-storybook -p 6006 -c .storybook",
    "storybook:build": "NODE_OPTIONS=--openssl-legacy-provider build-storybook -c .storybook -o ../../website/stories/vue",
    "test:exports": "node ./test/module/is-es-module.mjs",
    "watch:es": "yarn --silent build --watch"
  },
  "dependencies": {
    "@swc/helpers": "0.5.20",
    "instantsearch-ui-components": "0.23.0",
    "instantsearch.js": "4.93.0",
    "mitt": "^3.0.1"
  },
  "peerDependencies": {
    "@vue/server-renderer": "^3.3.0",
    "algoliasearch": ">= 5 < 6",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@vue/server-renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/compiler-sfc": "3.3.13",
    "@vue/server-renderer": "3.3.13",
    "@vue/test-utils": "2.4.6",
    "algoliasearch": "^5.50.0",
    "algoliasearch-helper": "3.28.1",
    "instantsearch.css": "8.13.0",
    "rollup-plugin-vue": "6.0.0",
    "vue": "3.3.13",
    "vue-i18n": "11.3.0",
    "vue-router": "5.0.4",
    "vue-slider-component": "3.2.24",
    "vue-tsc": "3.2.6",
    "vuex": "4.1.0"
  }
}
